{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Codex bounded review",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "summary", "findings"],
  "properties": {
    "status": {
      "enum": ["PASS", "CHANGES_REQUIRED", "BLOCKED"]
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "findings": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "file", "line", "problem", "required_fix"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
          },
          "severity": {
            "enum": ["critical", "high", "medium", "low"]
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "line": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "problem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "required_fix": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {"const": "PASS"}
        }
      },
      "then": {
        "properties": {
          "findings": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "CHANGES_REQUIRED"}
        }
      },
      "then": {
        "properties": {
          "findings": {"minItems": 1}
        }
      }
    }
  ]
}
