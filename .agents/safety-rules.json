{
  "expected_workspace_name": "Resus-codex",
  "expected_branch": "codex/work",
  "runtime_dir": ".agent-state",
  "max_changed_files": 20,
  "max_diff_lines": 5000,
  "diff_growth_ratio": 1.75,
  "diff_growth_min_lines": 100,
  "protected_paths": [
    ".agents/",
    ".agent-state/",
    "scripts/agent_loop.py",
