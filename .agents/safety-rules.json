    "auth",
    "authentication",
    "authorization",
    "permission",
    "secret",
    "credential",
    "payment",
    "billing",
    "migration",
    "deploy",
    "release",
    "crypto",
    "cipher",
    "database"
  ],
  "sensitive_diff_keywords": [
    "password",
    "api_key",
    "secret",
    "private_key",
    "access_token",
    "refresh_token",
    "drop table",
    "delete from",
