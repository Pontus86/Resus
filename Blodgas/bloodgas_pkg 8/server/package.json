{
  "name": "bloodgas-ocr-server",
  "version": "1.0.0",
  "description": "Vision-model OCR proxy for the Blood Gas Analyzer. Holds the Anthropic API key server-side and transcribes blood gas photos to text.",
  "type": "module",
  "main": "ocr-server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node ocr-server-local.js",
    "dev": "node --watch ocr-server.js",
    "start:local": "node ocr-server-local.js",
    "dev:local": "node --watch ocr-server-local.js",
    "start:tesseract": "node ocr-server-tesseract.js",
    "dev:tesseract": "node --watch ocr-server-tesseract.js",
    "start:ensemble": "node ocr-server-ensemble.js",
    "dev:ensemble": "node --watch ocr-server-ensemble.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.40.0",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "sharp": "^0.35.2",
    "tesseract.js": "^5.1.1",
    "tsx": "^4.22.4"
  }
}
